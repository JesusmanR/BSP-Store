# ==============================================================================
# BSP STORE (COLOMBIA) — PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# ==============================================================================
# Copia este archivo a `.env` para desarrollo local.
# NUNCA subas el archivo `.env` ni credenciales reales al repositorio Git.

# ------------------------------------------------------------------------------
# 1. Aplicación y Entorno
# ------------------------------------------------------------------------------
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="BSP Store"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_CURRENCY="COP"
NEXT_PUBLIC_DEFAULT_LOCALE="es-CO"

# ------------------------------------------------------------------------------
# 2. Base de Datos PostgreSQL 17 (Prisma ORM)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://bsp_app:CHANGE_ME_LOCAL_PASSWORD@localhost:5432/bsp_store?schema=public"
TEST_DATABASE_URL="postgresql://bsp_app:CHANGE_ME_LOCAL_PASSWORD@localhost:5432/bsp_store_test?schema=public"

# ------------------------------------------------------------------------------
# 3. Autenticación y Seguridad de Sesiones (Auth / JWT)
# ------------------------------------------------------------------------------
# Genera un secreto seguro con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="reemplazar_por_secreto_aleatorio_de_64_caracteres_en_env_local"
AUTH_SESSION_MAX_AGE_SECONDS="604800"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ------------------------------------------------------------------------------
# 4. Medios de Pago en Colombia (Wompi + Transferencia Inmediata Llave Bre-B)
# ------------------------------------------------------------------------------
PAYMENT_DEFAULT_PROVIDER="wompi"

# Transferencia Inmediata Bre-B (0% comisión / Sin costo de pasarela)
NEXT_PUBLIC_BREB_KEY="@bbbsp"
NEXT_PUBLIC_BREB_RECIPIENT_NAME="BSP Store Colombia"

# Wompi Colombia (Exclusivo para PSE, Tarjetas de Crédito/Débito y otros medios)
WOMPI_ENVIRONMENT="sandbox"
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=""
WOMPI_PRIVATE_KEY=""
WOMPI_INTEGRITY_SECRET=""
WOMPI_EVENTS_SECRET=""

# Bold Colombia (Botón de Pagos / API en Línea) — Sandbox / Producción
BOLD_ENVIRONMENT="sandbox"
NEXT_PUBLIC_BOLD_IDENTITY_KEY=""
BOLD_SECRET_KEY=""
BOLD_WEBHOOK_SECRET=""

# Mercado Pago Colombia — Sandbox / Producción
MERCADOPAGO_ENVIRONMENT="sandbox"
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=""
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""
